---
import BaseLayout from './BaseLayout.astro';
import Navigation from '@components/ui/Navigation.astro';
import Footer from '@components/sections/Footer.astro';
import { getLangFromUrl } from '@i18n/utils';

interface Props {
  title?: string;
  ogType?: "website" | "article";
  alternates?: { en: string; fr: string };
  description?: string;
}

const { title, ogType, alternates, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={title} lang={lang} ogType={ogType} alternates={alternates} description={description}>
  <Navigation alternates={alternates} />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
