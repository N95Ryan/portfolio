---
import MainLayout from "@layouts/MainLayout.astro";
import BackgroundAnimation from "@components/ui/BackgroundAnimation.astro";
import SkillsSection from "@components/skills/SkillsSection.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { skillsDetails } from "@/data/skillDetails";

const title = "Skills | Ryan PINA-SILASSE";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  languages,
  frontend,
  backend,
  database,
  testing,
  devops,
  tools,
  aiTools,
} = skillsDetails;
---

<MainLayout title={title}>
  <BackgroundAnimation />
  <div class="flex flex-col min-h-screen py-16 px-4">
    <div id="skills">
      <h3 class="text-5xl font-semibold text-indigo-500 text-center">
        {t("skills.title")}
      </h3>
      <hr class="my-8 border-t border-indigo-700 w-1/2 mx-auto" />
    </div>

    <SkillsSection skills={languages} category="languages" lang={lang} />
    <SkillsSection skills={frontend} category="frontend" lang={lang} />
    <SkillsSection skills={backend} category="backend" lang={lang} />
    <SkillsSection skills={database} category="database" lang={lang} />
    <SkillsSection skills={testing} category="testing" lang={lang} />
    <SkillsSection skills={devops} category="devops" lang={lang} />
    <SkillsSection skills={tools} category="tools" lang={lang} />
    <SkillsSection skills={aiTools} category="aiTools" lang={lang} />
  </div>
</MainLayout>
