---
import MainLayout from "@layouts/MainLayout.astro";
import BackgroundAnimation from "@components/ui/BackgroundAnimation.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { formatArticleDate, blogArticlePath, blogListPath } from "@lib/blog";
import {
  getAlternate,
  getArticleBySlug,
  type ArticleLang,
} from "@lib/notion";

export const prerender = false;

const lang = getLangFromUrl(Astro.url) as ArticleLang;
const t = useTranslations(lang);
const slugParam = Astro.params.slug;

if (!slugParam) {
  return new Response("Not Found", { status: 404, statusText: "Not Found" });
}

let article;
try {
  article = await getArticleBySlug(lang, slugParam);
} catch (error) {
  console.error("blog article", error);
  article = null;
}

if (!article) {
  return new Response("Not Found", { status: 404, statusText: "Not Found" });
}

const alternateSlug = article.translationKey
  ? await getAlternate(article.translationKey, lang)
  : null;

const alternates = {
  en:
    lang === "en"
      ? blogArticlePath("en", article.slug)
      : alternateSlug
        ? blogArticlePath("en", alternateSlug)
        : blogListPath("en"),
  fr:
    lang === "fr"
      ? blogArticlePath("fr", article.slug)
      : alternateSlug
        ? blogArticlePath("fr", alternateSlug)
        : blogListPath("fr"),
};

const title = `${article.title} | Ryan PINA-SILASSE`;
const formattedDate = formatArticleDate(article.date, lang);
const backHref = blogListPath(lang);
---

<MainLayout
  title={title}
  ogType="article"
  description={article.description}
  alternates={alternates}
  ogImage="/images/og-blog.png"
>
  <BackgroundAnimation />
  <article class="flex flex-col min-h-screen py-16 px-4">
    <div class="mx-auto w-full max-w-3xl">
      <a
        href={backHref}
        class="text-sm text-indigo-400 hover:text-purple-300 transition-colors"
      >
        {t("blog.back")}
      </a>
      <header class="mt-6 border-b border-indigo-900/60 pb-8">
        <time class="text-sm text-gray-400" datetime={article.date}>
          {formattedDate}
        </time>
        <h1 class="mt-2 text-4xl font-semibold text-indigo-400">
          {article.title}
        </h1>
        {
          article.tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {article.tags.map((tag) => (
                <li class="rounded-full bg-indigo-950/80 px-3 py-1 text-xs text-indigo-300">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </header>
      <div
        class="blog-prose prose prose-invert prose-indigo max-w-none mt-10"
        set:html={article.html}
      />
    </div>
  </article>
</MainLayout>
