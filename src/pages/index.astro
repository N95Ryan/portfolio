---
import MainLayout from "@layouts/MainLayout.astro";
import HeroTitle from "@components/hero/HeroTitle.astro";
import BackgroundAnimation from "@components/ui/BackgroundAnimation.astro";

const title = "Ryan PINA-SILASSE | Software Engineer";
const description =
  "Software Engineer specializing in Go and TypeScript. React, Next.js, Astro, PostgreSQL, Docker and Cloudflare. Based in Quebec, open to relocation to Toronto.";
---

<MainLayout title={title} description={description}>
  <BackgroundAnimation />
  <HeroTitle />
</MainLayout>
