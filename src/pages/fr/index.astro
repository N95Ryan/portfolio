---
import MainLayout from "@layouts/MainLayout.astro";
import HeroTitle from "@components/hero/HeroTitle.astro";
import BackgroundAnimation from "@components/ui/BackgroundAnimation.astro";

const title = "Ryan PINA-SILASSE | Ingénieur Logiciel";
const description =
  "Ingénieur logiciel full-stack spécialisé en Go et React. Je suis responsable de bout en bout de systèmes de production simples et fiables. Basé au Québec.";
