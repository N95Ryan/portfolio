---
import MainLayout from "@layouts/MainLayout.astro";
import HeroTitle from "@components/hero/HeroTitle.astro";
import BackgroundAnimation from "@components/ui/BackgroundAnimation.astro";

const title = "Ryan PINA-SILASSE | Ingénieur Logiciel";
const description =
  "Ingénieur logiciel Go et TypeScript. React, Next.js, Astro, PostgreSQL, Docker et Cloudflare. Basé au Québec, ouvert à une relocalisation à Toronto.";
---

<MainLayout title={title} description={description}>
  <BackgroundAnimation />
  <HeroTitle />
</MainLayout>
