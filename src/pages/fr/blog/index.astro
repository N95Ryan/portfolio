---
import MainLayout from "@layouts/MainLayout.astro";
import BackgroundAnimation from "@components/ui/BackgroundAnimation.astro";
import ArticleCard from "@components/blog/ArticleCard.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getPublishedArticles } from "@lib/notion";

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let articles;
try {
  articles = await getPublishedArticles(lang);
} catch (error) {
  console.error("blog index", error);
  articles = [];
}

const title = t("blog.meta.title") as string;
const alternates = { en: "/blog", fr: "/fr/blog" };
---

<MainLayout title={title} alternates={alternates}>
  <BackgroundAnimation />
  <div class="flex flex-col min-h-screen py-16 px-4">
    <div id="blog">
      <h3 class="text-5xl font-semibold text-indigo-500 text-center">
        {t("blog.title")}
      </h3>
      <hr class="my-8 border-t border-indigo-700 w-1/2 mx-auto" />
    </div>
    <div class="mx-auto w-full max-w-3xl space-y-8">
      {
        articles.length === 0 ? (
          <p class="text-center text-gray-400">{t("blog.empty")}</p>
        ) : (
          articles.map((article) => <ArticleCard article={article} />)
        )
      }
    </div>
  </div>
</MainLayout>
