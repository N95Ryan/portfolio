---
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@types/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="mt-8 w-full max-w-5xl mx-auto rounded-lg bg-gradient-to-br from-gray-800/80 to-gray-950/80 px-6 py-8"
  style="box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2), 0 0 16px rgba(99, 102, 241, 0.08);"
>
  <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6 text-center">
    {t("about.whereHeading.title")}
  </h2>
  <p class="text-white font-semibold text-base sm:text-lg mb-4 leading-relaxed">
    {t("about.whereHeading.line")}
  </p>
  <p class="text-gray-300 text-sm leading-relaxed mb-4">
    {t("about.whereHeading.paragraph1")}
  </p>
  <p class="text-gray-300 text-sm leading-relaxed">
    {t("about.whereHeading.paragraph2")}
  </p>
</div>
