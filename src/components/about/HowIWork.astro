---
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@types/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cardClass =
  "how-work-card w-full p-6 bg-gradient-to-br from-gray-800 to-gray-950 hover:from-gray-700 hover:to-gray-900 border border-white/10 rounded-lg shadow-xl hover:shadow-2xl transition-all duration-500 ease-out hover:scale-105 font-mono text-xs sm:text-sm text-left";
const cardShadow =
  "box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(99, 102, 241, 0.1);";

const steps = [
  {
    stepKey: "about.howIWork.listen.step",
    principleKey: "about.howIWork.listen.principle",
    descriptionKey: "about.howIWork.listen.description",
  },
  {
    stepKey: "about.howIWork.learn.step",
    principleKey: "about.howIWork.learn.principle",
    descriptionKey: "about.howIWork.learn.description",
  },
  {
    stepKey: "about.howIWork.apply.step",
    principleKey: "about.howIWork.apply.principle",
    descriptionKey: "about.howIWork.apply.description",
  },
  {
    stepKey: "about.howIWork.measure.step",
    principleKey: "about.howIWork.measure.principle",
    descriptionKey: "about.howIWork.measure.description",
  },
] as const;
---

<div class="mt-12 w-full max-w-5xl mx-auto">
  <h2 class="text-3xl sm:text-4xl font-bold text-white mb-8 text-center">
    {t("about.howIWork.title")}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {
      steps.map(({ stepKey, principleKey, descriptionKey }) => (
        <div class={cardClass} style={cardShadow}>
          <h3 class="text-cyan-400 text-sm sm:text-base font-semibold mb-1">
            {t(stepKey)}
          </h3>
          <p class="text-gray-500 mb-2">
            {"// "}
            {t(principleKey)}
          </p>
          <p class="how-work-card-line text-gray-300 leading-relaxed">
            {t(descriptionKey)}
          </p>
        </div>
      ))
    }
  </div>

  <div
    class="how-work-card mt-4 sm:mt-6 w-full p-6 bg-gradient-to-br from-gray-800 to-gray-950 hover:from-gray-700 hover:to-gray-900 border border-white/10 rounded-lg shadow-xl hover:shadow-2xl transition-all duration-500 ease-out hover:scale-105 font-mono text-xs sm:text-sm text-center"
    style={cardShadow}
  >
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 text-gray-300 leading-relaxed"
    >
      <span class="inline-flex items-center gap-2 text-cyan-400 text-sm sm:text-base font-semibold">
        <svg
          class="w-[1.125rem] h-[1.125rem] shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          ></path>
        </svg>
        <span>{t("about.howIWork.repeat.step")}</span>
      </span>
      <span class="text-gray-300">{t("about.howIWork.repeat.description")}</span>
    </div>
  </div>
</div>

<style>
  .how-work-card-line {
    position: relative;
    padding-left: 1.1rem;
  }

  .how-work-card-line::before {
    content: ">";
    position: absolute;
    left: 0;
    color: rgb(34 211 238);
  }
</style>
