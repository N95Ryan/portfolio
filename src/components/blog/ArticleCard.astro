---
import { formatArticleDate, blogArticlePath } from "@lib/blog";
import type { Article } from "@lib/notion";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const href = blogArticlePath(article.lang, article.slug);
const formattedDate = formatArticleDate(article.date, article.lang);
---

<article
  class="rounded-lg border border-indigo-900/60 bg-gray-900/40 p-6 transition-colors hover:border-indigo-600/80"
>
  <time class="text-sm text-gray-400" datetime={article.date}>{formattedDate}</time>
  <h2 class="mt-2 text-2xl font-semibold text-indigo-400">
    <a href={href} class="hover:text-purple-300 transition-colors">
      {article.title}
    </a>
  </h2>
  {
    article.description && (
      <p class="mt-3 text-gray-300 leading-relaxed">{article.description}</p>
    )
  }
  {
    article.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {article.tags.map((tag) => (
          <li class="rounded-full bg-indigo-950/80 px-3 py-1 text-xs text-indigo-300">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
