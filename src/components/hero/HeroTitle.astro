---
// src/components/hero/HeroTitle.astro
import CTAButtons from "./CTAButtons.astro";
import HeroTerminal from "./HeroTerminal.astro";
import { buildHeroTimeline } from "./heroTimeline";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const jobTitleLine1 = t("hero.jobTitle") as string;
const jobStackLine2 = t("hero.jobStack") as string;
const jobTitleChars = jobTitleLine1.split("");
const jobStackChars = jobStackLine2.split("");
const timeline = buildHeroTimeline(jobTitleLine1, jobStackLine2);
---

<div class="flex flex-col items-center justify-center min-h-screen px-4">
  <h1
    class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 mb-4 animate-fade-down animate-duration-800"
  >
    Ryan PINA-SILASSE
  </h1>
  <h2 class="text-center max-w-3xl tracking-tight">
    <span
      class="block flex flex-wrap justify-center text-2xl md:text-3xl text-white"
    >
      {
        jobTitleChars.map((char: string, i: number) => (
          <span
            class="inline-block animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none"
            style={`animation-delay: ${timeline.line1CharBaseDelayMs + i * timeline.line1StaggerMs}ms`}
          >
            {char === " " ? "\u00A0" : char}
          </span>
        ))
      }
    </span>
    <span
      class="block mt-2 flex flex-wrap justify-center text-xl md:text-2xl font-medium text-gray-200"
    >
      {
        jobStackChars.map((char: string, i: number) => (
          <span
            class="inline-block animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none"
            style={`animation-delay: ${timeline.line2CharBaseDelayMs + i * timeline.line2StaggerMs}ms`}
          >
            {char === " " ? "\u00A0" : char}
          </span>
        ))
      }
    </span>
  </h2>
  <h3
    class="text-lg md:text-xl text-white tracking-tight flex flex-wrap justify-center items-center gap-x-2 mt-4"
  >
    <span
      class="inline-block animate-fade-right motion-reduce:opacity-100 motion-reduce:animate-none animate-duration-500"
      style={`animation-delay: ${timeline.taglineDelaysMs[0]}ms`}
      >{t("hero.tagline.needs")}</span
    >
    <span
      class="inline-block animate-fade-right motion-reduce:opacity-100 motion-reduce:animate-none animate-duration-500 text-cyan-400"
      style={`animation-delay: ${timeline.taglineDelaysMs[1]}ms`}
      >{`→`}</span
    >
    <span
      class="inline-block animate-fade-right motion-reduce:opacity-100 motion-reduce:animate-none animate-duration-500"
      style={`animation-delay: ${timeline.taglineDelaysMs[2]}ms`}
      >{t("hero.tagline.challenges")}</span
    >
    <span
      class="inline-block animate-fade-right motion-reduce:opacity-100 motion-reduce:animate-none animate-duration-500 text-cyan-400"
      style={`animation-delay: ${timeline.taglineDelaysMs[3]}ms`}
      >{`→`}</span
    >
    <span
      class="inline-block animate-fade-right motion-reduce:opacity-100 motion-reduce:animate-none animate-duration-500"
      style={`animation-delay: ${timeline.taglineDelaysMs[4]}ms`}
      >{t("hero.tagline.solutions")}</span
    >
  </h3>

  <p
    class="mt-8 md:mt-10 max-w-xl text-center text-sm md:text-base text-gray-300 leading-relaxed animate-fade-up motion-reduce:opacity-100 motion-reduce:animate-none animate-duration-600"
    style={`animation-delay: ${timeline.paragraphDelayMs}ms`}
  >
    {t("hero.summary")}
  </p>

  <HeroTerminal timeline={timeline} />

  <CTAButtons buttonsDelayMs={timeline.buttonsDelayMs} />
</div>
