---
// src/components/hero/HeroTitle.astro
import CTAButtons from "./CTAButtons.astro";
import HeroTerminal from "./HeroTerminal.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const jobTitleLine1 = t("hero.jobTitle") as string;
---

<div class="flex flex-col items-center justify-center min-h-screen px-4">
  <h1
    class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-indigo-600 mb-4"
  >
    Ryan PINA-SILASSE
  </h1>
  <h2 class="text-center max-w-3xl tracking-tight">
    <span class="block text-2xl md:text-3xl text-white">
      {jobTitleLine1}
    </span>
    <h3
      class="text-lg md:text-xl text-white tracking-tight flex flex-wrap justify-center items-center gap-x-2 mt-4"
    >
      <span>{t("hero.tagline.needs")}</span>
      <span class="text-cyan-400">{`→`}</span>
      <span>{t("hero.tagline.challenges")}</span>
      <span class="text-cyan-400">{`→`}</span>
      <span>{t("hero.tagline.solutions")}</span>
    </h3>

    <p
      class="mt-8 md:mt-10 max-w-xl text-center text-sm md:text-base text-gray-300 leading-relaxed"
    >
      {t("hero.summary")}
    </p>

    <HeroTerminal />

    <CTAButtons />
  </h2>
</div>
